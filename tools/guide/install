#!/usr/bin/env bash
set -euo pipefail

# Guide - Local LLM CLI Tool
# Unified Installation Script

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Configuration
PROJECT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
BUILD_DIR="${PROJECT_ROOT}/build"
PREFIX="${PREFIX:-$HOME/.local}"

# Flags
DO_BUILD=true
DO_INSTALL_BINARIES=false
DO_INSTALL_SYSTEMD=false
INSTALL_LOCAL=false
VERBOSE=false

# Functions
print_color() {
    local color=$1
    shift
    echo -e "${color}$@${NC}"
}

print_success() { print_color "$GREEN" "✓ $@"; }
print_info() { print_color "$BLUE" "ℹ $@"; }
print_warn() { print_color "$YELLOW" "⚠ $@"; }
print_error() { print_color "$RED" "✗ $@"; }

usage() {
    cat <<EOF
Guide Installation Script

Usage: $0 [OPTIONS]

OPTIONS:
    -h, --help          Show this help message
    -b, --build-only    Only build binaries, don't install
    -i, --install       Install binaries to $PREFIX/bin
    -s, --systemd       Install systemd service (requires sudo)
    -l, --local         Install to ~/.local (default)
    --prefix PATH       Install to custom prefix
    -v, --verbose       Verbose output
    --clean             Clean build artifacts before building

EXAMPLES:
    # Build only
    $0 --build-only

    # Build and install binaries locally
    $0 --install

    # Build, install binaries, and set up systemd service
    $0 --install --systemd

    # Install to custom location
    $0 --install --prefix=/usr/local

ENVIRONMENT:
    PREFIX          Installation prefix (default: \$HOME/.local)
    GUIDE_CONFIG    Override config file location

For systemd service setup, see: systemd/README.md
EOF
    exit 0
}

detect_go() {
    if command -v go >/dev/null 2>&1; then
        print_success "Found Go: $(go version)"
        return 0
    elif [ -f "$PROJECT_ROOT/shell.nix" ]; then
        print_info "Go not found, but shell.nix detected"
        print_info "Run: nix-shell --run './install $*'"
        return 1
    else
        print_error "Go not found. Please install Go 1.21+ or use nix-shell"
        return 1
    fi
}

check_dependencies() {
    print_info "Checking dependencies..."
    
    if ! detect_go; then
        exit 1
    fi
    
    # Check Go version
    GO_VERSION=$(go version | grep -oP 'go\K[0-9]+\.[0-9]+' || echo "0.0")
    GO_MAJOR=$(echo "$GO_VERSION" | cut -d. -f1)
    GO_MINOR=$(echo "$GO_VERSION" | cut -d. -f2)
    
    if [ "$GO_MAJOR" -lt 1 ] || ([ "$GO_MAJOR" -eq 1 ] && [ "$GO_MINOR" -lt 21 ]); then
        print_error "Go 1.21+ required, found $GO_VERSION"
        exit 1
    fi
    
    print_success "Dependencies OK"
}

build_binaries() {
    print_info "Building binaries..."
    
    # Ensure dependencies are up to date
    print_info "Updating dependencies..."
    go mod tidy
    
    mkdir -p "$BUILD_DIR"
    
    # Build guide client
    print_info "Building guide client..."
    if [ "$VERBOSE" = true ]; then
        go build -v -o "$BUILD_DIR/guide" ./cmd/guide
    else
        go build -o "$BUILD_DIR/guide" ./cmd/guide
    fi
    print_success "Built: $BUILD_DIR/guide"
    
    # Build guide-llama-launcher
    print_info "Building guide-llama-launcher..."
    if [ "$VERBOSE" = true ]; then
        go build -v -o "$BUILD_DIR/guide-llama-launcher" ./cmd/guide-llama-launcher
    else
        go build -o "$BUILD_DIR/guide-llama-launcher" ./cmd/guide-llama-launcher
    fi
    print_success "Built: $BUILD_DIR/guide-llama-launcher"
    
    print_success "Build complete"
}

install_binaries() {
    print_info "Installing binaries to $PREFIX/bin..."
    
    mkdir -p "$PREFIX/bin"
    
    install -m 755 "$BUILD_DIR/guide" "$PREFIX/bin/"
    print_success "Installed: $PREFIX/bin/guide"
    
    install -m 755 "$BUILD_DIR/guide-llama-launcher" "$PREFIX/bin/"
    print_success "Installed: $PREFIX/bin/guide-llama-launcher"
    
    # Check if PREFIX/bin is in PATH
    if [[ ":$PATH:" != *":$PREFIX/bin:"* ]]; then
        print_warn "$PREFIX/bin is not in your PATH"
        print_info "Add this to your ~/.bashrc or ~/.zshrc:"
        print_info "  export PATH=\"$PREFIX/bin:\$PATH\""
    fi
}

install_systemd() {
    print_info "Installing systemd service..."
    
    if [ "$EUID" -eq 0 ]; then
        print_warn "Running as root"
    else
        print_info "This requires sudo privileges"
    fi
    
    # Ensure binaries are installed system-wide for systemd
    if [ ! -f "/usr/local/bin/guide-llama-launcher" ]; then
        print_info "Installing launcher to /usr/local/bin..."
        sudo install -m 755 "$BUILD_DIR/guide-llama-launcher" /usr/local/bin/
    fi
    
    if [ ! -f "/usr/local/bin/guide" ]; then
        print_info "Installing client to /usr/local/bin..."
        sudo install -m 755 "$BUILD_DIR/guide" /usr/local/bin/
    fi
    
    # Install service file
    print_info "Installing systemd service file..."
    sudo cp "$PROJECT_ROOT/systemd/guide-llama-server.service" /etc/systemd/system/
    print_success "Installed: /etc/systemd/system/guide-llama-server.service"
    
    # Create config directory
    sudo mkdir -p /etc/guide
    
    # Install config if it doesn't exist
    if [ ! -f "/etc/guide/config.toml" ]; then
        print_info "Installing example configuration..."
        sudo cp "$PROJECT_ROOT/systemd/config.toml" /etc/guide/config.toml
        print_warn "Please edit /etc/guide/config.toml with your model and binary paths"
        print_info "  sudo nano /etc/guide/config.toml"
    else
        print_info "Configuration already exists at /etc/guide/config.toml"
    fi
    
    # Reload systemd
    print_info "Reloading systemd..."
    sudo systemctl daemon-reload
    
    print_success "Systemd service installed"
    print_info ""
    print_info "Next steps:"
    print_info "  1. Edit configuration: sudo nano /etc/guide/config.toml"
    print_info "  2. Start service: sudo systemctl start guide-llama-server"
    print_info "  3. Enable on boot: sudo systemctl enable guide-llama-server"
    print_info "  4. Check status: sudo systemctl status guide-llama-server"
    print_info ""
    print_info "For detailed instructions, see: systemd/README.md"
}

clean_build() {
    print_info "Cleaning build artifacts..."
    rm -rf "$BUILD_DIR"
    print_success "Clean complete"
}

main() {
    cd "$PROJECT_ROOT"
    
    # Parse arguments
    while [[ $# -gt 0 ]]; do
        case $1 in
            -h|--help)
                usage
                ;;
            -b|--build-only)
                DO_INSTALL_BINARIES=false
                DO_INSTALL_SYSTEMD=false
                shift
                ;;
            -i|--install)
                DO_INSTALL_BINARIES=true
                shift
                ;;
            -s|--systemd)
                DO_INSTALL_SYSTEMD=true
                DO_INSTALL_BINARIES=true  # systemd requires binaries
                shift
                ;;
            -l|--local)
                INSTALL_LOCAL=true
                PREFIX="$HOME/.local"
                shift
                ;;
            --prefix)
                PREFIX="$2"
                shift 2
                ;;
            -v|--verbose)
                VERBOSE=true
                shift
                ;;
            --clean)
                clean_build
                shift
                ;;
            *)
                print_error "Unknown option: $1"
                echo ""
                usage
                ;;
        esac
    done
    
    print_info "Guide Installation"
    print_info "=================="
    echo ""
    
    # Check dependencies
    check_dependencies
    echo ""
    
    # Build
    if [ "$DO_BUILD" = true ]; then
        build_binaries
        echo ""
    fi
    
    # Install binaries
    if [ "$DO_INSTALL_BINARIES" = true ]; then
        install_binaries
        echo ""
    fi
    
    # Install systemd
    if [ "$DO_INSTALL_SYSTEMD" = true ]; then
        install_systemd
        echo ""
    fi
    
    # Summary
    if [ "$DO_INSTALL_BINARIES" = false ] && [ "$DO_INSTALL_SYSTEMD" = false ]; then
        print_success "Build complete!"
        print_info "Binaries are in: $BUILD_DIR/"
        print_info ""
        print_info "To install:"
        print_info "  $0 --install              # Install to ~/.local/bin"
        print_info "  $0 --install --systemd    # Install with systemd service"
    else
        print_success "Installation complete!"
        
        if [ "$DO_INSTALL_SYSTEMD" = true ]; then
            print_info ""
            print_warn "Remember to configure /etc/guide/config.toml before starting the service"
        fi
    fi
}

main "$@"
