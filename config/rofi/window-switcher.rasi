/* Window Switcher - List Style */

@import "~/.config/rofi/config.rasi"

window {
    /* Fullscreen overlay */
    fullscreen: true;
    location: center;
    anchor: center;
    width: 100%;
    height: 100%;
    
    /* Center the list in the middle area of the screen */
    padding: 15% 15%;
    
    /* Ensure background matches theme but allows transparency if set */
    background-color: @background;
    border: 0;
}

configuration {
    /* Show app name and title */
    window-format: "{c} · {t}";
    
    /* Vim-style keybindings for window switcher */
    kb-row-down: "Down,Control+n,j";
    kb-row-up: "Up,Control+p,k";
    kb-accept-entry: "Return,KP_Enter,l";
}

mainbox {
    orientation: vertical;
    children: [ listview ];
    spacing: 0;
    margin: 0;
    padding: 0;
}

listview {
    /* List mode: 1 column */
    columns: 1;
    lines: 15;
    
    spacing: 4px;
    cycle: true;
    dynamic: true;
    layout: vertical;
    scrollbar: false;
    
    /* No flow, just top to bottom */
    flow: vertical;
    fixed-height: false;
}

element {
    orientation: horizontal;
    padding: 8px;
    spacing: 12px;
    border-radius: 16px;
}

element selected {
    background-color: @selected-normal-background;
    text-color: @selected-normal-foreground;
}

element-icon {
    size: 28px;
    vertical-align: 0.5;
}

element-text {
    vertical-align: 0.5;
    text-color: inherit;
}
